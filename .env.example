# Supabase (públicas, seguras para expor no cliente)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Preços e dados de pagamento (mostrados na UI)
VITE_SUBSCRIPTION_PRICE_BASICO=1999
VITE_SUBSCRIPTION_PRICE_PRO=3499
VITE_MCX_NUMBER=943231005

# Email usado para mostrar o link do painel /admin no cliente.
# A aplicação real de permissões de super-admin é feita no Supabase
# (tabela app_settings + função is_super_admin), não apenas aqui.
VITE_SUPER_ADMIN_EMAIL=

# --- Apenas para a Supabase Edge Function verify-payment (nunca no cliente) ---
# Configurar como secrets do projeto Supabase (supabase secrets set ...),
# não colocar num ficheiro .env do frontend.
ANTHROPIC_API_KEY=
ANTHROPIC_VERIFY_MODEL=claude-sonnet-4-6
